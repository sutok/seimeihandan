  "validation_rules": {
    "character_validation": [
      "対応する漢字辞書またはひらがな辞書に文字が存在する",
      "画数が1以上81以下の範囲内である",
      "判定結果が6段階（大吉・吉・中吉・小吉・凶・大凶）のいずれかである"
    ],
    "gogaku_validation": [
      "天格 = 姓の全文字の画数合計",
      "人格 = 姓の最後の文字 + 名の最初の文字",
      "地格 = 名の全文字の画数合計",
      "外格 = 総格 - 人格",
      "総格 = 姓名の全文字の画数合計",
      "すべての格の値が1以上81以下"
    ],
    "special_case_validation": [
      "一文字姓の場合：天格 = 姓の画数 + 1（霊数）",
      "一文字名の場合：地格 = 名の画数 + 1（霊数）",
      "外格が1の場合：吉として扱う（霊数扱い）"
    ]
  },
  "expected_api_responses": {
